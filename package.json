{
  "name": "safety-mong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:server": "esbuild server.ts --outfile=server.compiled.cjs --bundle --platform=node --format=cjs --external:next --external:socket.io --external:better-sqlite3 --alias:@=./src",
    "dev": "pnpm build:server && NODE_OPTIONS='--max-old-space-size=3072' node server-entry.cjs",
    "build": "NODE_OPTIONS='--max-old-space-size=3072' next build && pnpm build:server",
    "start": "NODE_ENV=production node server-entry.cjs",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@tailwindcss/typography": "^0.5.19",
    "ai": "^6.0.156",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.44.2",
    "jose": "^6.0.11",
    "next": "16.2.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
